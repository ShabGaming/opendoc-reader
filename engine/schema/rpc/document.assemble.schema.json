{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShabGaming/opendoc-reader/blob/main/engine/schema/rpc/document.assemble.schema.json",
  "title": "document.assemble",
  "description": "Joins finished IR Page files into one Document IR file (the root of ir.schema.json), so Rust never has to build or parse IR. `pages` lists the Page files in page order.",
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "../ir.schema.json#/$defs/Source"
        },
        "engine": {
          "$ref": "common.schema.json#/$defs/Engine"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/AbsolutePath"
          }
        },
        "outPath": {
          "$ref": "common.schema.json#/$defs/AbsolutePath"
        }
      },
      "required": [
        "source",
        "engine",
        "pages",
        "outPath"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/AbsolutePath"
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "pageCount"
      ]
    }
  }
}
